# Maintainer: Berk Kucuk <berkkucukk@proton.me>
pkgname=haze
pkgver=2.12.0
pkgrel=1
pkgdesc="Anonymous encrypted P2P chat over the Tor network"
arch=('x86_64')
url="https://github.com/berk-kucuk/Haze"
license=('GPL-3.0-only')
# Python libraries (PyQt6, stem, cryptography, aiohttp, sounddevice, …) come
# from maze-python, the shared Maze venv at /opt/maze/venv. This package ships
# only its own source tree and runs it with that interpreter.
depends=(
    'maze-python'
    'tor'
)
optdepends=(
    'obfs4proxy: obfs4 bridges, for networks that block Tor'
    'snowflake: snowflake bridges, for networks that block obfs4 too'
)
# LOCAL BUILD: the source tarball is generated from the local working tree by
# ../build-pkg.sh (NOT fetched from GitHub). To publish to the AUR, restore the
# github archive::URL source and the real sha256sums.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

_install_dir="/opt/${pkgname}"

package() {
    local _src="${srcdir}/Haze-${pkgver}"

    # The application: the `haze` package as a plain directory tree, importable
    # with /opt/haze on sys.path (assets resolve via __file__, so nothing needs
    # pip's package-data machinery).
    install -dm755 "${pkgdir}${_install_dir}"
    cp -r "${_src}/src/haze" "${pkgdir}${_install_dir}/haze"
    find "${pkgdir}${_install_dir}" -type d -name __pycache__ -prune -exec rm -rf {} +
    install -m644 "${_src}/haze_transparent_logo.png" "${pkgdir}${_install_dir}/" 2>/dev/null || true

    # /usr/bin launcher — the shared interpreter, this tree on the path.
    install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${pkgname}" <<'EOF'
#!/usr/bin/env bash
export PYTHONPATH="/opt/haze${PYTHONPATH:+:$PYTHONPATH}"
exec /opt/maze/venv/bin/python3 -m haze "$@"
EOF

    # Desktop entry
    install -Dm644 "${_src}/installer/haze.desktop" \
        "${pkgdir}/usr/share/applications/${pkgname}.desktop"

    # Icons — pixmaps and hicolor at all standard sizes
    install -Dm644 "${_src}/src/haze/assets/logo.png" \
        "${pkgdir}/usr/share/pixmaps/${pkgname}.png"
    for _size in 16 22 32 48 64 128 256; do
        install -Dm644 "${_src}/src/haze/assets/logo.png" \
            "${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps/${pkgname}.png"
    done

    # License
    if [[ -f "${_src}/LICENSE" ]]; then
        install -Dm644 "${_src}/LICENSE" \
            "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
