# AppArmor profile for Haze — shipped in COMPLAIN mode.
#
# Haze accepts connections from the whole Tor network, so a bug in its
# network code is reachable by strangers. This profile describes what the app
# legitimately does; anything outside it is LOGGED (complain mode), not
# blocked, so no feature can break while the profile is being proven.
#
#   See what it would have blocked:  sudo maze-audit   (or: journalctl -k -g 'apparmor="ALLOWED"')
#   Enforce it once the log is clean: sudo aa-enforce /etc/apparmor.d/haze
#   Local additions (kept across updates): /etc/apparmor.d/local/haze
#
# The explicit deny rules are different in kind: they name places that are
# never legitimate for a chat app (SSH/GPG keys, wallets, autostart,
# shell start-up files), so they are written to hold without exception — they
# are safe to enforce from day one, and are always audited.

abi <abi/4.0>,
include <tunables/global>

@{HAZE_APP}     = /opt/haze
@{MAZE_VENV}    = /opt/maze/venv

profile haze /usr/bin/haze flags=(complain) {
  include <abstractions/base>
  include <abstractions/bash>
  include <abstractions/consoles>
  include <abstractions/python>
  include <abstractions/qt6>
  include <abstractions/kde>
  include <abstractions/fonts>
  include <abstractions/freedesktop.org>
  include <abstractions/X>
  include <abstractions/wayland>
  include <abstractions/dri-enumerate>
  include <abstractions/mesa>
  include <abstractions/opengl>
  include <abstractions/vulkan>
  include <abstractions/dbus-session-strict>
  include <abstractions/nameservice>
  include <abstractions/openssl>
  include <abstractions/ssl_certs>
  include <abstractions/user-tmp>
  include <abstractions/audio>
  include <abstractions/private-files-strict>

  # The launcher script, then the shared Maze interpreter.
  /usr/bin/haze r,
  /usr/bin/bash ix,
  /usr/bin/env ix,
  /usr/bin/python3* ix,
  @{MAZE_VENV}/bin/python3* ix,
  @{MAZE_VENV}/{,**} r,
  @{MAZE_VENV}/**.so* mr,
  @{HAZE_APP}/{,**} r,
  /usr/share/pixmaps/haze.png r,
  /usr/share/icons/hicolor/*/apps/haze.png r,
  /usr/share/icons/hicolor/scalable/apps/haze.svg r,
  @{PROC}/@{pid}/{stat,status,cmdline,mounts,fd/} r,
  @{sys}/devices/system/cpu/{,**} r,

  # Network: local SOCKS/control ports of its own tor, nothing else directly.
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  network unix stream,

  # Home: attachments are picked from anywhere in it and received files are
  # saved wherever the user chooses, so the home directory is readable and
  # writable — minus the places below that no chat app has any business
  # touching. Its own data lives in ~/.config/haze (settings, the vault) and
  # ~/.local/state/haze (log). What the profile really takes away is the rest
  # of the system: no writes outside home and /tmp, no running other programs
  # except its own tor, the bridge transports and Tor Browser.
  owner @{HOME}/ r,
  owner @{HOME}/** rwk,

  # Never legitimate. (private-files-strict above already
  # covers SSH/GPG keys, browser and mail profiles, KWallet, autostart and the
  # shell start-up files; these are the persistence spots it misses.)
  audit deny @{HOME}/.config/systemd/{,**} wl,
  audit deny @{HOME}/.config/plasma-workspace/{,**} wl,
  audit deny @{HOME}/.local/share/applications/{,**} wl,
  audit deny @{HOME}/.{xprofile,xinitrc,xsession,pam_environment} wl,
  audit deny @{HOME}/.password-store/{,**} mrwkl,
  audit deny @{HOME}/.local/share/keyrings/{,**} mrwkl,

  # Its own tor, in a child profile.
  /usr/bin/tor cx -> tor,

  # "Open in Tor Browser": hand off to the browser (its own profile if it
  # has one, otherwise unconfined — it is a separate, sandboxed program).
  owner @{HOME}/.local/share/torbrowser/tbb/*/tor-browser/Browser/start-tor-browser PUx,
  /opt/tor-browser/Browser/start-tor-browser PUx,
  /usr/local/share/tor-browser/Browser/start-tor-browser PUx,
  /usr/bin/{tor-browser,torbrowser-launcher} PUx,
  /usr/bin/flatpak PUx,

  profile tor {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openssl>

    /usr/bin/tor mr,
    /usr/share/tor/{,**} r,
    /etc/tor/{,**} r,
    @{PROC}/@{pid}/{stat,status,meminfo} r,
    @{PROC}/meminfo r,
    @{sys}/devices/system/cpu/{,**} r,

    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,
    network netlink raw,
    network unix stream,

    # stem writes the torrc to the temp dir; DataDirectory is mkdtemp().
    owner /tmp/torrc-* r,
    owner /tmp/haze_tor_*/{,**} rwk,

    # Pluggable transports for bridges (obfs4 / snowflake), run by tor.
    /usr/bin/{lyrebird,obfs4proxy,snowflake-client} ix,

    include if exists <local/haze.tor>
  }

  include if exists <local/haze>
}
